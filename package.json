    "@earendil-works/pi-tui": "1.0.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@oh-my-pi/pi-ai": "18.5.0",
    "fast-xml-parser": "5.11.2",
    "marked": "18.0.11",
