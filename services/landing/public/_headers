# Security headers for static assets (BRIEF 9). The Worker fills the same set on its own responses
# (src/worker/http.ts). Same origin only: no inline scripts, no third-party origins.
# style-src has no 'unsafe-inline': the pages set dynamic values through CSSOM only (allowed under CSP).
# img-src allows data: for the CSS mask of the dotted divider (components.css).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/brand/*
  Cache-Control: public, max-age=86400
