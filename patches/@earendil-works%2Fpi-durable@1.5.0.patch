--- /dev/null
+++ b/dist/storage/replay-error.js
@@ -0,0 +1,11 @@
+import { StorageRequestError } from "../errors.js";
+/** Deterministic failure decoding already-read bytes; never an I/O or commit failure. */
+export class DocumentReplayError extends StorageRequestError {
+    constructor(documentId, revision, cause) {
+        super(`Document ${documentId} revision ${revision} cannot replay: ${cause instanceof Error ? cause.message : String(cause)}`);
+        this.name = "DocumentReplayError";
+        this.documentId = documentId;
+        this.revision = revision;
+        this.cause = cause;
+    }
+}
