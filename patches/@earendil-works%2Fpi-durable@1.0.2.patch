+/** Resolve against the current model at every preparation/select; never persist model-sized defaults. */
+export function modelCompactionPolicy(settings, contextWindow) {
+    const policy = settings.compaction;
+    if (!Number.isFinite(contextWindow) || contextWindow <= 0)
+        return { ...policy, blockingTokens: Infinity };
+    const specified = settings.compactionOverrides ?? {};
+    const finite = (value, fallback) => Number.isFinite(value) && value >= 0 ? value : fallback;
+    const reserve = finite(specified.reserveTokens, Math.min(16384, Math.floor(contextWindow * 0.25)));
+    const ratio = Number.isFinite(policy.maxContextRatio) && policy.maxContextRatio > 0 && policy.maxContextRatio <= 1
+        ? policy.maxContextRatio : 0.7;
+    const cap = finite(policy.maxContextTokens, 300000);
+    const blockingTokens = Math.max(1, Math.floor(Math.min(contextWindow - reserve, contextWindow * ratio, cap > 0 ? cap : Infinity)));
+    return {
+        ...policy,
+        // This is output headroom, NOT window minus the absolute cap: summaries must not grow with window size.
+        reserveTokens: Math.max(1, Math.min(reserve, contextWindow - 1)),
+        blockingTokens,
+        keepRecentTokens: finite(specified.keepRecentTokens, Math.min(20000, Math.floor(blockingTokens * 0.25))),
+        backgroundTokens: Math.min(Math.max(0, blockingTokens - 1), finite(specified.backgroundTokens,
+            Math.min(32768, Math.floor(contextWindow * 0.1), Math.floor(blockingTokens * 0.25)))),
+    };
+}
